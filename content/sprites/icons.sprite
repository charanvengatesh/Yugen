# =============================================================================
# Relics
# =============================================================================
# The only two icons in the file with a pure white in the palette. That is the
# point: nothing else the player can hold is allowed to be that bright, so the
# Pearl is findable in a full inventory without reading a single label.

@sprite icon_pearl
cellsW    2
cellsH    2
pal       . #c8c2d8 #eae6f4 #ffffff
seq |
  32
  21

@sprite icon_pearl_shard
cellsW    2
cellsH    2
pal       . #c8c2d8 #eae6f4 #ffffff
seq |
  .3
  12

