# Deep-cave crystal. Glows enough to read a cavern by (lightEmit is raised above
# the value `emissive` would derive — the bloom is subtle, the light is not).
@block crystal
name         Crystal
state        solid
color        152 112 232
colorVar     16
texture      crystalline
shimmer      150
edge         200
emissive     0.5
lightEmit    7
hardness     5
blastResist  2
tags         rock diggable buildable
heat.conduct 50
drop         item=crystal_shard count=2..4

@block wood
name         Wood
state        solid
color        150 100 55
colorVar     20
texture      fibrous
edge         110
hardness     1.5
blastResist  0.8
tags         diggable buildable
flammable.igniteChance 0.06
flammable.burnTime     90
flammable.burnsInto    smoke
heat.conduct 18
heat.igniteAt 35
