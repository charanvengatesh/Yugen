# Terrain — the rock, soil and stone-family blocks the world is carved out of.
# `empty` (code 0) lives here because it is terrain's absence, and because the
# cell grid's zero value has to be a real record like everything else.

# Air still conducts (heat crosses a gap) and sheds slowly, so a flame on one
# side of a one-cell hole still warms the other. Nothing to dig, hence hardness 0.
@block empty
name         Air
state        empty
color        0 0 0
colorVar     0
hardness     0
heat.conduct 26
heat.cool    2

@block stone
name         Stone
state        solid
color        96 92 84
colorVar     16
texture      layered
edge         150
hardness     3
blastResist  2
tags         rock diggable buildable
heat.conduct 56
drop         item=stone_chunk count=1

@block dirt
name         Dirt
state        solid
color        120 82 48
colorVar     18
texture      grain
edge         30
hardness     1
blastResist  0.6
tags         soil diggable buildable
heat.conduct 34

@block sand
name         Sand
state        powder
color        222 196 120
colorVar     22
texture      grain
edge         12
density      2
hardness     0.5
blastResist  0.4
tags         soil diggable buildable
heat.conduct 40
heat.meltAt  50
heat.meltInto glass

# Sand that has drunk water: heavier, and it bakes back to dry sand.
@block wetSand
name         Wet Sand
state        powder
color        168 140 92
colorVar     18
texture      grain
edge         18
density      2.4
hardness     0.6
blastResist  0.4
tags         soil diggable buildable
heat.conduct 46
heat.cool    3
heat.meltAt  30
heat.meltInto sand

@block sandstone
name         Sandstone
state        solid
color        200 175 120
colorVar     14
texture      layered
edge         120
hardness     2
blastResist  1.6
tags         rock diggable buildable
heat.conduct 46
heat.meltAt  62
heat.meltInto glass

