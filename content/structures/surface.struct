# Surface landmarks — the things you see from the ground line.
#
# Glyph conventions shared across content/structures/:
#   .  force air      _  keep terrain      L  a cache (mark=loot)      X  a den (mark=spawn)
# Everything else is declared per record, because a glyph's material is what
# makes a cabin a cabin and a wreck a wreck.
#
# Rarity budget: the surface lattice offers a candidate roughly every 112
# columns and half of those pass the density gate, so a `rarity` of 0.35 here is
# about one of these per 640 columns walked — far enough apart that finding one
# is an event, close enough that a session finds several.

@struct surface_cabin
name      "Woodcutter's Cabin"
place     surface
rarity    0.4
weight    1.6
biomes    plains savanna jungle swamp
anchor    bottom_center
flatness  4
mirror    true
legend    c=W  block=wood
legend    c=G  block=glass
legend    c=L  block=goldOre|ironOre|coalOre  mark=loot
legend    c=X  mark=spawn
body |
  ___WWWWW___
  __WWWWWWW__
  _WWWWWWWWW_
  _W.......W_
  _WGG.L.GGW_
  _W.......W_
  _...X....W_
  _WWWWWWWWW_

@struct surface_cabin_ruin
name      "Collapsed Cabin"
place     surface
rarity    0.4
weight    1.0
biomes    plains savanna jungle swamp tundra
anchor    bottom_center
flatness  6
mirror    true
legend    c=W  block=wood
legend    c=M  block=moss|dirt  soft=true
legend    c=L  block=ironOre|coalOre  mark=loot
legend    c=X  mark=spawn
body |
  ___________
  __W.....W__
  _W..W...W._
  _WM......._
  _W..L.....W
  _...X....MW
  _WWW.WWWWW_

# The tall one. `repeat` is what makes a single template cover every tower on
# the continent: rows 3..5 are one storey (room, room, floor-with-a-hatch) and
# get stamped 1..5 times, so the silhouette runs from a 10-cell stub to a
# 22-cell landmark without a second record or a switch in the generator.
@struct watchtower
name      "Ruined Watchtower"
place     surface
rarity    0.28
weight    1.2
anchor    bottom_center
flatness  5
mirror    true
legend    c=S  block=stone
legend    c=L  block=goldOre|ironOre  mark=loot
legend    c=X  mark=spawn
repeat.from  3
repeat.rows  3
repeat.times 1..5
body |
  _SSSSS_
  _S.S.S_
  _SSSSS_
  _S...S_
  _S...S_
  _S.SSS_
  _S...S_
  _S..LS_
  _..X.S_
  _SSSSS_

# Shore places are offered the columns whose ground line is inside the beach
# band, which is exactly where a hull would have come ashore. Sunk two rows so
# the keel is buried in the sand rather than resting on it.
@struct shore_wreck
name      "Beached Hull"
place     shore
rarity    0.5
weight    1.0
anchor    bottom_center
sink      2
flatness  5
mirror    true
legend    c=W  block=wood
legend    c=D  block=gravel
legend    c=L  block=goldOre|ironOre  mark=loot
legend    c=X  mark=spawn
body |
  ____W_____W____
  ____W_____W____
  __WWW.....WWW__
  _WW....X....WW_
  _W....L......W_
  _DWWWWWWWWWWWD_
